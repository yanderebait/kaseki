{
  "name": "kaseki",
  "version": "0.1.0",
  "description": "A self-hosted, single-user personal life dashboard",
  "author": "yanderebait",
  "license": "AGPL-3.0",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux",
    "rebuild:native": "cd node_modules/better-sqlite3-multiple-ciphers && prebuild-install --runtime=electron --target=41.7.2",
    "postinstall": "npm run rebuild:native",
    "selftest": "electron-vite build && KASEKI_DATA_DIR=/tmp/kaseki-selftest KASEKI_SELFTEST=1 electron out/main/index.js",
    "package:win:cross": "bash scripts/package-win-from-linux.sh"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@tiptap/extension-task-item": "^3.26.1",
    "@tiptap/extension-task-list": "^3.26.1",
    "@tiptap/react": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "better-sqlite3-multiple-ciphers": "^12.10.0",
    "dompurify": "^3.4.10",
    "marked": "^18.0.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^41.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prebuild-install": "^7.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.0"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@12.10.0": true,
    "electron@42.4.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true
  }
}
